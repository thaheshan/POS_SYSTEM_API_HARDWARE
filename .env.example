# ===========================================
# Supabase PostgreSQL - Direct Connection (used by Prisma migrations only)
# ===========================================
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.hwvxlndpulxkevzfanye.supabase.co:5432/postgres?sslmode=require"

