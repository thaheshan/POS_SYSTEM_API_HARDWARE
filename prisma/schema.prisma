
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  owner
  manager
  cashier
  store_keeper
  accountant
}

enum SubscriptionPlan {
  starter
  professional
  business
  enterprise
}

enum SubscriptionStatus {
  active
  suspended
  cancelled
}

enum TaxCategory {
  standard_vat
  zero_vat
  exempt
}





model Shop {
  id                      String              @id @default(uuid()) @map("shop_id")
  shopName                String              @map("shop_name")
  businessRegistration    String?             @map("business_registration")
  address                 String?
  city                    String?
  district                String?
  province                String?
  postalCode              String?             @map("postal_code")
  phone                   String?
  email                   String?
  website                 String?
  logoUrl                 String?             @map("logo_url")
  taxNumber               String?             @map("tax_number")
  vatRegistrationNumber   String?             @map("vat_registration_number")
  vatRegistrationDate     DateTime?           @db.Date @map("vat_registration_date")
  subscriptionPlan        SubscriptionPlan?   @map("subscription_plan")
  subscriptionStatus      SubscriptionStatus? @map("subscription_status")
  subscriptionStartDate   DateTime?           @db.Date @map("subscription_start_date")
  subscriptionEndDate     DateTime?           @db.Date @map("subscription_end_date")
  isActive                Boolean             @default(true) @map("is_active")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  
  categories              Category[]
  brands                  Brand[]
  units                   Unit[]
  products                Product[]
  productVariants          ProductVariant[]
  stocks                  Stock[]
 

  @@map("shops")
}

model User {
  user_id               String    @id @default(uuid())
  tenant_id             String
  email                 String    @unique
  password_hash         String
  first_name            String?
  last_name             String?
  phone               String?
  role                UserRole @default(cashier) @map("role")
  is_active             Boolean   @default(true)
  is_verified           Boolean   @default(false)
  two_factor_enabled    Boolean   @default(false)
  twoFactorSecret     String?  @map("two_factor_secret")
  last_login            DateTime?
  failed_login_attempts Int       @default(0)
  account_locked_until  DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  createdProducts     Product[] @relation("ProductCreatedBy")
 

  @@index([tenant_id])
  @@map("users")
}






model Category {
  id              String    @id @default(uuid()) @map("category_id")
  tenantId        String    @map("tenant_id")
  categoryName    String    @map("category_name")
  categoryCode    String    @map("category_code")
  description     String?
  parentCategoryId String?  @map("parent_category_id")
  categoryLevel   Int?      @map("category_level")
  displayOrder    Int?      @map("display_order")
  iconUrl         String?   @map("icon_url")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  shop            Shop      @relation(fields: [tenantId], references: [id])
  parentCategory  Category? @relation("CategoryToCategory", fields: [parentCategoryId], references: [id])
  subCategories   Category[] @relation("CategoryToCategory")
  products        Product[]

  @@unique([tenantId, categoryCode])
  @@index([tenantId])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid()) @map("brand_id")
  tenantId    String   @map("tenant_id")
  brandName   String   @map("brand_name")
  description String?
  logoUrl     String?  @map("logo_url")
  website     String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop        Shop     @relation(fields: [tenantId], references: [id])
  products    Product[]

  @@index([tenantId])
  @@map("brands")
}

model Unit {
  id          String   @id @default(uuid()) @map("unit_id")
  tenantId    String   @map("tenant_id")
  unitName    String   @map("unit_name")
  unitCode    String   @map("unit_code")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop        Shop     @relation(fields: [tenantId], references: [id])
  products    Product[]

  @@unique([tenantId, unitCode])
  @@index([tenantId])
  @@map("units")
}

model Product {
  id                  String         @id @default(uuid()) @map("product_id")
  tenantId            String         @map("tenant_id")
  name                String         @map("product_name")
  description         String?        @map("product_description")
  sku                 String         @map("sku")
  barcode             String?        @map("barcode")
  categoryId          String         @map("category_id")
  brandId             String?        @map("brand_id")
  unitId              String?        @map("unit_id")
  purchasePrice       Decimal?       @db.Decimal(10, 2) @map("purchase_price")
  sellingPrice        Decimal         @db.Decimal(10, 2) @map("selling_price")
  minimumSellingPrice Decimal?       @db.Decimal(10, 2) @map("minimum_selling_price")
  markupPercentage    Decimal?       @db.Decimal(5, 2) @map("markup_percentage")
  taxRate             Decimal?       @db.Decimal(5, 2) @map("tax_rate")
  taxCategory         TaxCategory     @map("tax_category")
  minimumStockLevel   Decimal?       @db.Decimal(10, 2) @map("minimum_stock_level")
  maximumStockLevel   Decimal?       @db.Decimal(10, 2) @map("maximum_stock_level")
  reorderQuantity     Decimal?       @db.Decimal(10, 2) @map("reorder_quantity")
  warrantyMonths      Int?           @map("warranty_months")
  hasVariants         Boolean        @default(false) @map("has_variants")
  isActive            Boolean        @default(true) @map("is_active")
  createdBy           String?        @map("created_by")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  shop                Shop           @relation(fields: [tenantId], references: [id])
  category            Category       @relation(fields: [categoryId], references: [id])
  brand               Brand?         @relation(fields: [brandId], references: [id])
  unit                Unit?          @relation(fields: [unitId], references: [id])
  creator             User?          @relation("ProductCreatedBy", fields: [createdBy], references: [user_id])
  variants            ProductVariant[]
  images              ProductImage[]
  stocks              Stock[]
  

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, categoryId])
  @@index([tenantId, name])
  @@map("products")
}

model ProductVariant {
  id                String   @id @default(uuid()) @map("variant_id")
  tenantId          String   @map("tenant_id")
  productId         String   @map("product_id")
  variantName       String?  @map("variant_name")
  sku               String   @map("sku")
  barcode           String?  @map("barcode")
  variantAttributes Json?    @map("variant_attributes")
  purchasePrice     Decimal? @db.Decimal(10, 2) @map("purchase_price")
  sellingPrice      Decimal? @db.Decimal(10, 2) @map("selling_price")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product           Product  @relation(fields: [productId], references: [id])
  shop              Shop     @relation(fields: [tenantId], references: [id])
  stocks            Stock[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, productId])
  @@map("product_variants")
}

model ProductImage {
  id           String   @id @default(uuid()) @map("image_id")
  productId    String   @map("product_id")
  imageUrl     String   @map("image_url")
  thumbnailUrl String?  @map("thumbnail_url")
  displayOrder Int?     @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  product      Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model Stock {
  id              String   @id @default(uuid()) @map("stock_id")
  tenantId        String   @map("tenant_id")
  productId       String   @map("product_id")
  variantId       String?  @map("variant_id")
  warehouseId     String?  @map("warehouse_id")
  branchId        String?  @map("branch_id")
  quantity        Decimal  @db.Decimal(10, 2) @map("quantity")
  reservedQuantity Decimal @default(0) @db.Decimal(10, 2) @map("reserved_quantity")
  availableQuantity Decimal? @db.Decimal(10, 2) @map("available_quantity")
  damagedQuantity Decimal @default(0) @db.Decimal(10, 2) @map("damaged_quantity")
  lastUpdated     DateTime @updatedAt @map("last_updated")

  shop            Shop     @relation(fields: [tenantId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([tenantId, branchId])
  @@index([tenantId, productId])
  @@index([tenantId, variantId])
  @@map("stock")
}












