
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  owner
  manager
  cashier
  store_keeper
  accountant
}

enum SubscriptionPlan {
  starter
  professional
  business
  enterprise
}

enum SubscriptionStatus {
  active
  suspended
  cancelled
}

enum TaxCategory {
  standard_vat
  zero_vat
  exempt
}

enum StockMovementType {
  in
  out
  adjustment
  transfer
  return
  damage
}

enum StockAdjustmentType {
  physical_count
  damage
  expiry
  correction
}

enum StockAdjustmentStatus {
  draft
  approved
  rejected
}

enum StockTransferStatus {
  pending
  in_transit
  received
  cancelled
}

enum SerialStatus {
  in_stock
  sold
  returned
  damaged
}

enum CustomerType {
  individual
  business
}

enum AddressType {
  billing
  shipping
  both
}

enum LoyaltyTransactionType {
  earned
  redeemed
  expired
  adjusted
}

enum SaleType {
  cash
  credit
  card
  mixed
}

enum PaymentStatus {
  paid
  partial
  unpaid
}

enum SalesInvoiceStatus {
  completed
  pending
  cancelled
  returned
}

enum QuotationStatus {
  draft
  sent
  accepted
  rejected
  expired
}

enum SalesReturnStatus {
  pending
  approved
  completed
  rejected
}

enum RefundMethod {
  cash
  credit_note
  exchange
}

enum PaymentType {
  sale
  purchase
  expense
  other
}

enum PaymentMethod {
  cash
  card
  bank_transfer
  cheque
  mobile_payment
}

enum PurchaseOrderStatus {
  draft
  sent
  acknowledged
  partial
  received
  cancelled
}

enum PurchaseInvoiceStatus {
  unpaid
  partial
  paid
  overdue
}

enum QualityCheckStatus {
  passed
  failed
  pending
}

enum CreditNoteStatus {
  issued
  used
  expired
  cancelled
}

enum ExpensePaymentMethod {
  cash
  card
  bank_transfer
  cheque
}

enum RecurringFrequency {
  daily
  weekly
  monthly
  yearly
}

model Shop {
  id                      String              @id @default(uuid()) @map("shop_id")
  shopName                String              @map("shop_name")
  businessRegistration    String?             @map("business_registration")
  address                 String?
  city                    String?
  district                String?
  province                String?
  postalCode              String?             @map("postal_code")
  phone                   String?
  email                   String?
  website                 String?
  logoUrl                 String?             @map("logo_url")
  taxNumber               String?             @map("tax_number")
  vatRegistrationNumber   String?             @map("vat_registration_number")
  vatRegistrationDate     DateTime?           @db.Date @map("vat_registration_date")
  subscriptionPlan        SubscriptionPlan?   @map("subscription_plan")
  subscriptionStatus      SubscriptionStatus? @map("subscription_status")
  subscriptionStartDate   DateTime?           @db.Date @map("subscription_start_date")
  subscriptionEndDate     DateTime?           @db.Date @map("subscription_end_date")
  isActive                Boolean             @default(true) @map("is_active")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  users                   User[]
  branches                Branch[]
  warehouses              Warehouse[]
  categories              Category[]
  brands                  Brand[]
  units                   Unit[]
  products                Product[]
  productVariants          ProductVariant[]
  suppliers               Supplier[]
  customers               Customer[]
  purchaseOrders          PurchaseOrder[]
  purchaseInvoices         PurchaseInvoice[]
  goodsReceivedNotes       GoodsReceivedNote[]
  salesInvoices           SalesInvoice[]
  quotations              Quotation[]
  salesReturns            SalesReturn[]
  payments                Payment[]
  creditNotes             CreditNote[]
  expenses                Expense[]
  stocks                  Stock[]
  stockMovements           StockMovement[]
  stockAdjustments         StockAdjustment[]
  stockTransfers           StockTransfer[]
  dailyTaxTrackings         DailyTaxTracking[]
  vatSummaries             VatSummary[]
  notifications            Notification[]
  auditLogs                AuditLog[]

  @@map("shops")
}

model User {
  id                  String   @id @default(uuid()) @map("user_id")
  tenantId            String   @map("tenant_id")
  email               String   @unique @map("email")
  passwordHash        String   @map("password_hash")
  firstName           String?  @map("first_name")
  lastName            String?  @map("last_name")
  phone               String?
  role                UserRole
  isActive            Boolean  @default(true) @map("is_active")
  isVerified          Boolean  @default(false) @map("is_verified")
  twoFactorEnabled    Boolean  @default(false) @map("two_factor_enabled")
  twoFactorSecret     String?  @map("two_factor_secret")
  lastLogin           DateTime? @map("last_login")
  failedLoginAttempts Int      @default(0) @map("failed_login_attempts")
  accountLockedUntil  DateTime? @map("account_locked_until")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  shop                Shop     @relation(fields: [tenantId], references: [id])
  managedBranches     Branch[] @relation("BranchManager")
  managedWarehouses   Warehouse[] @relation("WarehouseManager")
  createdProducts     Product[] @relation("ProductCreatedBy")
  stockMovements      StockMovement[]
  stockAdjustments    StockAdjustment[] @relation("StockAdjustmentCreatedBy")
  stockApprovals      StockAdjustment[] @relation("StockAdjustmentApprovedBy")
  purchaseOrders      PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  purchaseApprovals   PurchaseOrder[] @relation("PurchaseOrderApprovedBy")
  goodsReceivedNotes  GoodsReceivedNote[]
  salesInvoices       SalesInvoice[] @relation("SalesInvoiceCashier")
  quotations          Quotation[]
  salesReturns        SalesReturn[] @relation("SalesReturnProcessedBy")
  salesReturnApprovals SalesReturn[] @relation("SalesReturnApprovedBy")
  creditNotes         CreditNote[]
  paymentsReceived    Payment[]
  expensesRecorded    Expense[] @relation("ExpenseRecordedBy")
  expensesApproved    Expense[] @relation("ExpenseApprovedBy")

  @@index([tenantId])
  @@map("users")
}

model Branch {
  id          String   @id @default(uuid()) @map("branch_id")
  tenantId    String   @map("tenant_id")
  branchName  String   @map("branch_name")
  branchCode  String?  @unique @map("branch_code")
  address     String?
  city        String?
  postalCode  String?  @map("postal_code")
  phone       String?
  email       String?
  managerId   String?  @map("manager_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop        Shop     @relation(fields: [tenantId], references: [id])
  manager     User?    @relation("BranchManager", fields: [managerId], references: [id])
  warehouses  Warehouse[]
  salesInvoices SalesInvoice[]
  expenses    Expense[]
  stocks      Stock[]

  @@index([tenantId])
  @@map("branches")
}

model Warehouse {
  id            String   @id @default(uuid()) @map("warehouse_id")
  tenantId      String   @map("tenant_id")
  branchId      String?  @map("branch_id")
  warehouseName String   @map("warehouse_name")
  warehouseCode String?  @unique @map("warehouse_code")
  address       String?
  capacity      Decimal? @db.Decimal(10, 2)
  managerId     String?  @map("manager_id")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  shop          Shop     @relation(fields: [tenantId], references: [id])
  branch        Branch?  @relation(fields: [branchId], references: [id])
  manager       User?    @relation("WarehouseManager", fields: [managerId], references: [id])
  binLocations  BinLocation[]
  stocks        Stock[]
  stockMovements StockMovement[]
  stockAdjustments StockAdjustment[]
  purchaseOrders  PurchaseOrder[]
  goodsReceivedNotes GoodsReceivedNote[]
  stockTransfersFrom StockTransfer[] @relation("StockTransferFrom")
  stockTransfersTo   StockTransfer[] @relation("StockTransferTo")
  salesInvoiceItems  SalesInvoiceItem[]
  salesReturnItems   SalesReturnItem[]
  serialNumbers SerialNumber[]
  batchNumbers  BatchNumber[]

  @@index([tenantId])
  @@map("warehouses")
}

model Category {
  id              String    @id @default(uuid()) @map("category_id")
  tenantId        String    @map("tenant_id")
  categoryName    String    @map("category_name")
  categoryCode    String    @map("category_code")
  description     String?
  parentCategoryId String?  @map("parent_category_id")
  categoryLevel   Int?      @map("category_level")
  displayOrder    Int?      @map("display_order")
  iconUrl         String?   @map("icon_url")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  shop            Shop      @relation(fields: [tenantId], references: [id])
  parentCategory  Category? @relation("CategoryToCategory", fields: [parentCategoryId], references: [id])
  subCategories   Category[] @relation("CategoryToCategory")
  products        Product[]

  @@unique([tenantId, categoryCode])
  @@index([tenantId])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid()) @map("brand_id")
  tenantId    String   @map("tenant_id")
  brandName   String   @map("brand_name")
  description String?
  logoUrl     String?  @map("logo_url")
  website     String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop        Shop     @relation(fields: [tenantId], references: [id])
  products    Product[]

  @@index([tenantId])
  @@map("brands")
}

model Unit {
  id          String   @id @default(uuid()) @map("unit_id")
  tenantId    String   @map("tenant_id")
  unitName    String   @map("unit_name")
  unitCode    String   @map("unit_code")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop        Shop     @relation(fields: [tenantId], references: [id])
  products    Product[]

  @@unique([tenantId, unitCode])
  @@index([tenantId])
  @@map("units")
}

model Product {
  id                  String         @id @default(uuid()) @map("product_id")
  tenantId            String         @map("tenant_id")
  name                String         @map("product_name")
  description         String?        @map("product_description")
  sku                 String         @map("sku")
  barcode             String?        @map("barcode")
  categoryId          String         @map("category_id")
  brandId             String?        @map("brand_id")
  unitId              String?        @map("unit_id")
  purchasePrice       Decimal?       @db.Decimal(10, 2) @map("purchase_price")
  sellingPrice        Decimal         @db.Decimal(10, 2) @map("selling_price")
  minimumSellingPrice Decimal?       @db.Decimal(10, 2) @map("minimum_selling_price")
  markupPercentage    Decimal?       @db.Decimal(5, 2) @map("markup_percentage")
  taxRate             Decimal?       @db.Decimal(5, 2) @map("tax_rate")
  taxCategory         TaxCategory     @map("tax_category")
  minimumStockLevel   Decimal?       @db.Decimal(10, 2) @map("minimum_stock_level")
  maximumStockLevel   Decimal?       @db.Decimal(10, 2) @map("maximum_stock_level")
  reorderQuantity     Decimal?       @db.Decimal(10, 2) @map("reorder_quantity")
  warrantyMonths      Int?           @map("warranty_months")
  hasVariants         Boolean        @default(false) @map("has_variants")
  isActive            Boolean        @default(true) @map("is_active")
  createdBy           String?        @map("created_by")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  shop                Shop           @relation(fields: [tenantId], references: [id])
  category            Category       @relation(fields: [categoryId], references: [id])
  brand               Brand?         @relation(fields: [brandId], references: [id])
  unit                Unit?          @relation(fields: [unitId], references: [id])
  creator             User?          @relation("ProductCreatedBy", fields: [createdBy], references: [id])
  variants            ProductVariant[]
  images              ProductImage[]
  stocks              Stock[]
  stockMovements      StockMovement[]
  stockAdjustmentItems StockAdjustmentItem[]
  stockTransferItems  StockTransferItem[]
  serialNumbers       SerialNumber[]
  batchNumbers        BatchNumber[]
  supplierProducts    SupplierProduct[]
  purchaseOrderItems  PurchaseOrderItem[]
  grnItems            GrnItem[]
  salesInvoiceItems   SalesInvoiceItem[]
  quotationItems      QuotationItem[]
  salesReturnItems    SalesReturnItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, categoryId])
  @@index([tenantId, name])
  @@map("products")
}

model ProductVariant {
  id                String   @id @default(uuid()) @map("variant_id")
  tenantId          String   @map("tenant_id")
  productId         String   @map("product_id")
  variantName       String?  @map("variant_name")
  sku               String   @map("sku")
  barcode           String?  @map("barcode")
  variantAttributes Json?    @map("variant_attributes")
  purchasePrice     Decimal? @db.Decimal(10, 2) @map("purchase_price")
  sellingPrice      Decimal? @db.Decimal(10, 2) @map("selling_price")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product           Product  @relation(fields: [productId], references: [id])
  shop              Shop     @relation(fields: [tenantId], references: [id])
  stocks            Stock[]
  stockMovements    StockMovement[]
  stockAdjustmentItems StockAdjustmentItem[]
  stockTransferItems StockTransferItem[]
  serialNumbers     SerialNumber[]
  batchNumbers      BatchNumber[]
  purchaseOrderItems PurchaseOrderItem[]
  grnItems          GrnItem[]
  salesInvoiceItems SalesInvoiceItem[]
  quotationItems    QuotationItem[]
  salesReturnItems  SalesReturnItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, productId])
  @@map("product_variants")
}

model ProductImage {
  id           String   @id @default(uuid()) @map("image_id")
  productId    String   @map("product_id")
  imageUrl     String   @map("image_url")
  thumbnailUrl String?  @map("thumbnail_url")
  displayOrder Int?     @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  product      Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model Stock {
  id              String   @id @default(uuid()) @map("stock_id")
  tenantId        String   @map("tenant_id")
  productId       String   @map("product_id")
  variantId       String?  @map("variant_id")
  warehouseId     String?  @map("warehouse_id")
  branchId        String?  @map("branch_id")
  quantity        Decimal  @db.Decimal(10, 2) @map("quantity")
  reservedQuantity Decimal @default(0) @db.Decimal(10, 2) @map("reserved_quantity")
  availableQuantity Decimal? @db.Decimal(10, 2) @map("available_quantity")
  damagedQuantity Decimal @default(0) @db.Decimal(10, 2) @map("damaged_quantity")
  lastUpdated     DateTime @updatedAt @map("last_updated")

  shop            Shop     @relation(fields: [tenantId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id])
  branch          Branch?  @relation(fields: [branchId], references: [id])

  @@index([tenantId, branchId])
  @@index([tenantId, productId])
  @@index([tenantId, variantId])
  @@map("stock")
}

model StockMovement {
  id            String   @id @default(uuid()) @map("movement_id")
  tenantId      String   @map("tenant_id")
  productId     String   @map("product_id")
  variantId     String?  @map("variant_id")
  warehouseId   String?  @map("warehouse_id")
  movementType  StockMovementType @map("movement_type")
  quantity      Decimal  @db.Decimal(10, 2)
  beforeQuantity Decimal? @db.Decimal(10, 2) @map("before_quantity")
  afterQuantity Decimal?  @db.Decimal(10, 2) @map("after_quantity")
  unitCost      Decimal?  @db.Decimal(10, 2) @map("unit_cost")
  totalCost     Decimal?  @db.Decimal(10, 2) @map("total_cost")
  referenceType String?   @map("reference_type")
  referenceId   String?   @map("reference_id")
  notes         String?
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  shop          Shop      @relation(fields: [tenantId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  creator       User?     @relation(fields: [createdBy], references: [id])

  @@index([tenantId, productId])
  @@map("stock_movements")
}

model StockAdjustment {
  id            String   @id @default(uuid()) @map("adjustment_id")
  tenantId      String   @map("tenant_id")
  warehouseId   String?  @map("warehouse_id")
  adjustmentDate DateTime @db.Date @map("adjustment_date")
  adjustmentType StockAdjustmentType @map("adjustment_type")
  reason        String?
  status        StockAdjustmentStatus @map("status")
  approvedBy    String?  @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  shop          Shop     @relation(fields: [tenantId], references: [id])
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  creator       User?    @relation("StockAdjustmentCreatedBy", fields: [createdBy], references: [id])
  approver      User?    @relation("StockAdjustmentApprovedBy", fields: [approvedBy], references: [id])
  items         StockAdjustmentItem[]

  @@index([tenantId])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id            String   @id @default(uuid()) @map("adjustment_item_id")
  adjustmentId  String   @map("adjustment_id")
  productId     String   @map("product_id")
  variantId     String?  @map("variant_id")
  systemQuantity Decimal? @db.Decimal(10, 2) @map("system_quantity")
  actualQuantity Decimal? @db.Decimal(10, 2) @map("actual_quantity")
  difference    Decimal? @db.Decimal(10, 2)
  unitCost      Decimal? @db.Decimal(10, 2) @map("unit_cost")
  totalValue    Decimal? @db.Decimal(10, 2) @map("total_value")
  notes         String?

  adjustment    StockAdjustment @relation(fields: [adjustmentId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([adjustmentId])
  @@map("stock_adjustment_items")
}

model StockTransfer {
  id              String   @id @default(uuid()) @map("transfer_id")
  tenantId        String   @map("tenant_id")
  transferNumber  String   @unique @map("transfer_number")
  fromWarehouseId String?  @map("from_warehouse_id")
  toWarehouseId   String?  @map("to_warehouse_id")
  transferDate    DateTime @db.Date @map("transfer_date")
  status          StockTransferStatus
  notes           String?
  requestedBy     String?  @map("requested_by")
  approvedBy      String?  @map("approved_by")
  receivedBy      String?  @map("received_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  shop            Shop     @relation(fields: [tenantId], references: [id])
  fromWarehouse   Warehouse? @relation("StockTransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse? @relation("StockTransferTo", fields: [toWarehouseId], references: [id])
  items           StockTransferItem[]

  @@index([tenantId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id               String   @id @default(uuid()) @map("transfer_item_id")
  transferId       String   @map("transfer_id")
  productId        String   @map("product_id")
  variantId        String?  @map("variant_id")
  quantityRequested Decimal? @db.Decimal(10, 2) @map("quantity_requested")
  quantitySent     Decimal? @db.Decimal(10, 2) @map("quantity_sent")
  quantityReceived Decimal? @db.Decimal(10, 2) @map("quantity_received")
  unitCost         Decimal? @db.Decimal(10, 2) @map("unit_cost")

  transfer         StockTransfer @relation(fields: [transferId], references: [id])
  product          Product   @relation(fields: [productId], references: [id])
  variant          ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([transferId])
  @@map("stock_transfer_items")
}

model BinLocation {
  id          String   @id @default(uuid()) @map("bin_id")
  warehouseId String   @map("warehouse_id")
  binCode     String   @map("bin_code")
  aisle       String?
  rack        String?
  shelf       String?
  capacity    Decimal? @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([warehouseId])
  @@map("bin_locations")
}

model SerialNumber {
  id            String   @id @default(uuid()) @map("serial_id")
  productId     String   @map("product_id")
  variantId     String?  @map("variant_id")
  serialNumber  String   @unique @map("serial_number")
  warehouseId   String?  @map("warehouse_id")
  status        SerialStatus
  purchaseDate  DateTime? @db.Date @map("purchase_date")
  saleDate      DateTime? @db.Date @map("sale_date")
  warrantyExpiry DateTime? @db.Date @map("warranty_expiry")
  createdAt     DateTime @default(now()) @map("created_at")

  product       Product  @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([productId])
  @@map("serial_numbers")
}

model BatchNumber {
  id               String   @id @default(uuid()) @map("batch_id")
  productId        String   @map("product_id")
  variantId        String?  @map("variant_id")
  batchNumber      String   @map("batch_number")
  warehouseId      String?  @map("warehouse_id")
  quantity         Decimal? @db.Decimal(10, 2)
  manufacturingDate DateTime? @db.Date @map("manufacturing_date")
  expiryDate       DateTime? @db.Date @map("expiry_date")
  receivedDate     DateTime? @db.Date @map("received_date")
  createdAt        DateTime @default(now()) @map("created_at")

  product          Product  @relation(fields: [productId], references: [id])
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse        Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([productId])
  @@map("batch_numbers")
}

model Supplier {
  id             String   @id @default(uuid()) @map("supplier_id")
  tenantId       String   @map("tenant_id")
  supplierName   String   @map("supplier_name")
  supplierCode   String?  @unique @map("supplier_code")
  contactPerson  String?  @map("contact_person")
  email          String?
  phone          String?
  mobile         String?
  address        String?
  city           String?
  postalCode     String?  @map("postal_code")
  taxNumber      String?  @map("tax_number")
  vatNumber      String?  @map("vat_number")
  paymentTerms   String?  @map("payment_terms")
  creditLimit    Decimal? @db.Decimal(10, 2) @map("credit_limit")
  creditPeriodDays Int?   @map("credit_period_days")
  bankDetails    Json?    @map("bank_details")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  shop            Shop     @relation(fields: [tenantId], references: [id])
  contacts        SupplierContact[]
  supplierProducts SupplierProduct[]
  purchaseOrders  PurchaseOrder[]
  goodsReceivedNotes GoodsReceivedNote[]
  purchaseInvoices PurchaseInvoice[]

  @@index([tenantId])
  @@map("suppliers")
}

model SupplierContact {
  id           String   @id @default(uuid()) @map("contact_id")
  supplierId   String   @map("supplier_id")
  contactName  String   @map("contact_name")
  designation  String?
  email        String?
  phone        String?
