generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TenantSetting {
  tenant_id          String   @id @db.Uuid 
  max_category_depth Int      @default(3)  
  updated_at         DateTime @updatedAt

  @@map("tenant_settings")
}

model Category {
  id                 String     @id @default(uuid()) @db.Uuid
  tenant_id          String     @db.Uuid
  name               String
  parent_category_id String?    @db.Uuid
  category_level     Int
  display_order      Int        @default(0)
  is_active          Boolean    @default(true)
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt

  //self referencing relationship for CategoryHierarchy
  parent             Category?  @relation("CategoryHierarchy", fields: [parent_category_id], references: [id])
  children           Category[] @relation("CategoryHierarchy")
  products           Product[] //relation should be define on the Product schema
  //Indexing
  @@index([tenant_id, parent_category_id])
  @@unique([tenant_id, name, parent_category_id]) 
  
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  name        String
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([tenant_id, name])
  @@map("brands")
}

model Unit {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  name       String
  symbol     String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, name])
  @@unique([tenant_id, symbol])
  @@map("units")
}

