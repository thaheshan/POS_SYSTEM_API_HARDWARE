generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  RETURN
  DAMAGE
}

enum TaxCategory {
  STANDARD_VAT
  ZERO_VAT
  EXEMPT
}

enum SaleType {
  CASH
  CREDIT
  CARD
  MIXED
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum InvoiceStatus {
  COMPLETED
  PENDING       // Used for "Held Bills" (30-minute reservation timeout)
  CANCELLED
  RETURNED
}

// ================= CORE / TENANT MODELS =================

model User {
  user_id               String    @id @default(uuid())
  tenant_id             String
  email                 String    @unique
  password_hash         String
  first_name            String?
  last_name             String?
  role                  String    @default("cashier")
  is_active             Boolean   @default(true)
  is_verified           Boolean   @default(false)
  two_factor_enabled    Boolean   @default(false)
  last_login            DateTime?
  failed_login_attempts Int       @default(0)
  account_locked_until  DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  shop                  Shop            @relation(fields: [tenant_id], references: [id])
  managedBranches       Branch[]        @relation("BranchManager")
  managedWarehouses     Warehouse[]     @relation("WarehouseManager")
  createdProducts       Product[]       @relation("ProductCreatedBy")
  stockMovements        StockMovement[] @relation("MovementCreator")
  salesInvoices         SalesInvoice[]  @relation("InvoiceCashier")
  receivedGrns          GoodsReceivedNote[] @relation("GrnReceiver")

  @@map("users")
}

model Shop {
  id                    String    @id @default(uuid()) @map("shop_id") @db.Uuid
  name                  String    @map("shop_name") @db.VarChar(200)
  businessRegistration  String?   @map("business_registration") @db.VarChar(100)
  
  // Relations
  users                 User[]
  branches              Branch[]
  warehouses            Warehouse[]
  categories            Category[]
  brands                Brand[]
  units                 Unit[]
  products              Product[]
  productVariants       ProductVariant[]
  stocks                Stock[]
  stockMovements        StockMovement[]
  salesInvoices         SalesInvoice[]
  goodsReceivedNotes  GoodsReceivedNote[]

  @@map("shops")
}

model Branch {
  id             String   @id @default(uuid()) @map("branch_id") @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String   @map("branch_name") @db.VarChar(200)
  code           String?  @unique @map("branch_code") @db.VarChar(50)
  
  managerId      String?  @map("manager_id") 
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  shop           Shop           @relation(fields: [tenantId], references: [id])
  manager        User?          @relation("BranchManager", fields: [managerId], references: [user_id])
  warehouses     Warehouse[]
  stocks         Stock[]
  salesInvoices  SalesInvoice[]

  @@map("branches")
}

model Category {
  id          String    @id @default(uuid()) @map("category_id") @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @map("category_name") @db.VarChar(200)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  
  shop        Shop      @relation(fields: [tenantId], references: [id])
  products    Product[]

  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid()) @map("brand_id") @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @map("brand_name") @db.VarChar(200)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  
  shop        Shop      @relation(fields: [tenantId], references: [id])
  products    Product[]

  @@map("brands")
}

model Unit {
  id           String    @id @default(uuid()) @map("unit_id") @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  name         String    @map("unit_name") @db.VarChar(50)
  abbreviation String    @db.VarChar(20)
  
  shop         Shop      @relation(fields: [tenantId], references: [id])
  products     Product[]

  @@map("units")
}

model Product {
  id                  String         @id @default(uuid()) @map("product_id")
  tenantId            String         @map("tenant_id")
  name                String         @map("product_name")
  description         String?        @map("product_description")
  sku                 String         @map("sku")
  barcode             String?        @map("barcode")
  categoryId          String         @map("category_id")
  brandId             String?        @map("brand_id")
  unitId              String?        @map("unit_id")
  purchasePrice       Decimal?       @db.Decimal(10, 2) @map("purchase_price")
  sellingPrice        Decimal        @db.Decimal(10, 2) @map("selling_price")
  minimumSellingPrice Decimal?       @db.Decimal(10, 2) @map("minimum_selling_price")
  markupPercentage    Decimal?       @db.Decimal(5, 2) @map("markup_percentage")
  taxRate             Decimal?       @db.Decimal(5, 2) @map("tax_rate")
  taxCategory         TaxCategory?   @map("tax_category") // Made optional to prevent strict enum errors if not provided
  minimumStockLevel   Decimal?       @db.Decimal(10, 2) @map("minimum_stock_level")
  maximumStockLevel   Decimal?       @db.Decimal(10, 2) @map("maximum_stock_level")
  reorderQuantity     Decimal?       @db.Decimal(10, 2) @map("reorder_quantity")
  warrantyMonths      Int?           @map("warranty_months")
  hasVariants         Boolean        @default(false) @map("has_variants")
  isActive            Boolean        @default(true) @map("is_active")
  createdBy           String?        @map("created_by")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  shop                Shop           @relation(fields: [tenantId], references: [id])
  category            Category       @relation(fields: [categoryId], references: [id])
  brand               Brand?         @relation(fields: [brandId], references: [id])
  unit                Unit?          @relation(fields: [unitId], references: [id])
  creator             User?          @relation("ProductCreatedBy", fields: [createdBy], references: [user_id])
  variants            ProductVariant[]
  images              ProductImage[]
  stocks              Stock[]
  stockMovements      StockMovement[]
  grnItems            GrnItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, categoryId])
  @@index([tenantId, name])
  @@map("products")
}

model ProductVariant {
  id                String   @id @default(uuid()) @map("variant_id")
  tenantId          String   @map("tenant_id")
  productId         String   @map("product_id")
  variantName       String?  @map("variant_name")
  sku               String   @map("sku")
  barcode           String?  @map("barcode")
  variantAttributes Json?    @map("variant_attributes")
  purchasePrice     Decimal? @db.Decimal(10, 2) @map("purchase_price")
  sellingPrice      Decimal? @db.Decimal(10, 2) @map("selling_price")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product           Product  @relation(fields: [productId], references: [id])
  shop              Shop     @relation(fields: [tenantId], references: [id])
  stocks            Stock[]
  stockMovements    StockMovement[]
  grnItems            GrnItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, productId])
  @@map("product_variants")
}

model ProductImage {
  id           String   @id @default(uuid()) @map("image_id")
  productId    String   @map("product_id")
  imageUrl     String   @map("image_url")
  thumbnailUrl String?  @map("thumbnail_url")
  displayOrder Int?     @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  product      Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model Warehouse {
  id            String   @id @default(uuid()) @map("warehouse_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  name          String   @map("warehouse_name") @db.VarChar(200)
  code          String?  @unique @map("warehouse_code") @db.VarChar(50)
  address       String?  @db.Text
  capacity      Decimal? @db.Decimal(10, 2)
  managerId     String?  @map("manager_id")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  shop          Shop     @relation(fields: [tenantId], references: [id])
  branch        Branch   @relation(fields: [branchId], references: [id])
  manager       User?    @relation("WarehouseManager", fields: [managerId], references: [user_id])
  stocks        Stock[]
  stockMovements StockMovement[]
  goodsReceivedNotes  GoodsReceivedNote[]

  @@map("warehouses")
}

model Stock {
  id                String   @id @default(uuid()) @map("stock_id") @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  productId         String   @map("product_id") 
  variantId         String?  @map("variant_id") 
  warehouseId       String   @map("warehouse_id") @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  
  quantity          Decimal  @db.Decimal(10, 2)
  reservedQuantity  Decimal  @default(0) @db.Decimal(10, 2) @map("reserved_quantity")
  availableQuantity Decimal? @db.Decimal(10, 2) @map("available_quantity") 
  damagedQuantity   Decimal  @default(0) @db.Decimal(10, 2) @map("damaged_quantity")
  
  lastUpdated       DateTime @updatedAt @map("last_updated")

  // Relations
  shop              Shop            @relation(fields: [tenantId], references: [id])
  product           Product         @relation(fields: [productId], references: [id])
  variant           ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id])
  branch            Branch          @relation(fields: [branchId], references: [id])

  @@unique([productId, variantId, warehouseId])
  @@map("stock")
}

model StockMovement {
  id              String       @id @default(uuid()) @map("movement_id") @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  productId       String       @map("product_id") 
  variantId       String?      @map("variant_id") 
  warehouseId     String       @map("warehouse_id") @db.Uuid
  
  movementType    MovementType @map("movement_type")
  quantity        Decimal      @db.Decimal(10, 2)
  beforeQuantity  Decimal?     @db.Decimal(10, 2) @map("before_quantity")
  afterQuantity   Decimal?     @db.Decimal(10, 2) @map("after_quantity")
  
  unitCost        Decimal?     @db.Decimal(10, 2) @map("unit_cost")
  totalCost       Decimal?     @db.Decimal(10, 2) @map("total_cost")
  
  referenceType   String?      @db.VarChar(50) @map("reference_type")
  referenceId     String?      @db.Uuid @map("reference_id")
  notes           String?      @db.Text
  
  createdBy       String?      @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at")

  // Relations
  shop            Shop            @relation(fields: [tenantId], references: [id])
  product         Product         @relation(fields: [productId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  creator         User?           @relation("MovementCreator", fields: [createdBy], references: [user_id])

  @@map("stock_movements")
}

model GoodsReceivedNote {
  id              String     @id @default(uuid()) @map("grn_id") @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  warehouseId     String     @map("warehouse_id") @db.Uuid
  
  // Optional link to a Purchase Order if that module exists later
  purchaseOrderId String?    @map("purchase_order_id") @db.Uuid 
  
  grnNumber       String     @unique @map("grn_number") @db.VarChar(50)
  receivedDate    DateTime   @default(now()) @map("received_date") @db.Date
  status          String     @default("completed") @db.VarChar(20)
  notes           String?    @db.Text
  
  receivedBy      String?    @map("received_by")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // Relations
  shop            Shop       @relation(fields: [tenantId], references: [id])
  warehouse       Warehouse  @relation(fields: [warehouseId], references: [id])
  receiver        User?      @relation("GrnReceiver", fields: [receivedBy], references: [user_id])
  items           GrnItem[]

  @@map("goods_received_notes")
}

model GrnItem {
  id              String     @id @default(uuid()) @map("grn_item_id") @db.Uuid
  grnId           String     @map("grn_id") @db.Uuid
  productId       String     @map("product_id") 
  variantId       String?    @map("variant_id") 
  
  quantity        Decimal    @db.Decimal(10, 2)
  unitCost        Decimal    @db.Decimal(10, 2) @map("unit_cost")
  totalCost       Decimal    @db.Decimal(10, 2) @map("total_cost")

  // Relations
  grn             GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  product         Product           @relation(fields: [productId], references: [id])
  variant         ProductVariant?   @relation(fields: [variantId], references: [id])

  @@map("grn_items")
}

// ================= SALES INVOICES (For 30-Min Held Bills) =================

model SalesInvoice {
  id                  String        @id @default(uuid()) @map("invoice_id") @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  branchId            String        @map("branch_id") @db.Uuid
  invoiceNumber       String        @unique @map("invoice_number") @db.VarChar(50)
  invoiceDate         DateTime      @map("invoice_date") @db.Date
  invoiceTime         DateTime      @map("invoice_time") @db.Time
  
  saleType            SaleType      @map("sale_type")
  subtotal            Decimal       @db.Decimal(10, 2)
  discountAmount      Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  discountPercentage  Decimal?      @map("discount_percentage") @db.Decimal(5, 2)
  taxAmount           Decimal?      @map("tax_amount") @db.Decimal(10, 2)
  totalAmount         Decimal       @map("total_amount") @db.Decimal(10, 2)
  
  paidAmount          Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)
  changeAmount        Decimal       @default(0) @map("change_amount") @db.Decimal(10, 2)
  balance             Decimal       @default(0) @db.Decimal(10, 2)
  
  paymentStatus       PaymentStatus @map("payment_status")
  status              InvoiceStatus 
  notes               String?       @db.Text
  
  cashierId           String?       @map("cashier_id")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  // Relations (Note: Customer ID left out as agreed)
  shop                Shop          @relation(fields: [tenantId], references: [id])
  branch              Branch        @relation(fields: [branchId], references: [id])
  cashier             User?         @relation("InvoiceCashier", fields: [cashierId], references: [user_id])

  @@map("sales_invoices")
}