// ================= ENUMS =================
enum WarehouseType {
  main
  branch_store
  damage
  transit
}

enum TransferStatus {
  pending
  in_transit
  received
  cancelled
}

// ================= MODELS =================
model User {
  user_id               String          @id @default(uuid())
  tenant_id             String
  email                 String          @unique
  password_hash         String
  first_name            String?
  last_name             String?
  role                  String          @default("cashier")
  is_active             Boolean         @default(true)
  is_verified           Boolean         @default(false)
  two_factor_enabled    Boolean         @default(false)
  last_login            DateTime?
  failed_login_attempts Int             @default(0)
  account_locked_until  DateTime?
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  createdWarehouses     Warehouse[]     @relation("WarehouseCreatedBy")
  createdTransfers      StockTransfer[] @relation("TransferCreatedBy")
  approvedTransfers     StockTransfer[] @relation("TransferApprovedBy")
  receivedTransfers     StockTransfer[] @relation("TransferReceivedBy")

  @@map("users")
}

model Warehouse {
  id                 String          @id @default(uuid())
  tenant_id          String
  branch_id          String?
  warehouse_name     String
  warehouse_code     String
  warehouse_type     WarehouseType
  address            String?
  is_active          Boolean         @default(true)
  is_default_for_pos Boolean         @default(false)
  created_by         String?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt

  creator            User?           @relation("WarehouseCreatedBy", fields: [created_by], references: [user_id])
  transfersFrom      StockTransfer[] @relation("TransferFromWarehouse")
  transfersTo        StockTransfer[] @relation("TransferToWarehouse")
  stocks             Stock[]
  stockMovements     StockMovement[]

  @@unique([warehouse_code, tenant_id])
  @@map("warehouses")
}

model StockTransfer {
  id                String              @id @default(uuid())
  transfer_number   String              @unique
  tenant_id         String
  from_warehouse_id String
  to_warehouse_id   String
  status            TransferStatus      @default(pending)
  created_by        String?
  approved_by       String?
  received_by       String?
  created_at        DateTime            @default(now())
  approved_at       DateTime?
  received_at       DateTime?
  updated_at        DateTime            @updatedAt

  fromWarehouse     Warehouse           @relation("TransferFromWarehouse", fields: [from_warehouse_id], references: [id])
  toWarehouse       Warehouse           @relation("TransferToWarehouse", fields: [to_warehouse_id], references: [id])
  creator           User?               @relation("TransferCreatedBy", fields: [created_by], references: [user_id])
  approver          User?               @relation("TransferApprovedBy", fields: [approved_by], references: [user_id])
  receiver          User?               @relation("TransferReceivedBy", fields: [received_by], references: [user_id])
  items             StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id                 String        @id @default(uuid())
  transfer_id        String
  product_id         String
  quantity_requested Float
  quantity_sent      Float?
  quantity_received  Float?
  discrepancy_flag   Boolean       @default(false)

  transfer           StockTransfer @relation(fields: [transfer_id], references: [id], onDelete: Cascade)

  @@map("stock_transfer_items")
}

model Stock {
  id           String    @id @default(uuid())
  tenant_id    String
  warehouse_id String
  product_id   String
  quantity     Float     @default(0)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id])

  @@unique([warehouse_id, product_id])
  @@map("stocks")
}

model StockMovement {
  id           String    @id @default(uuid())
  tenant_id    String
  warehouse_id String
  product_id   String
  type         String
  quantity     Float
  reference_id String?
  created_at   DateTime  @default(now())

  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id])

  @@map("stock_movements")
}

model TenantFeature {
  id         String   @id @default(uuid())
  tenant_id  String
  feature    String
  is_enabled Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, feature])
  @@map("tenant_features")
}