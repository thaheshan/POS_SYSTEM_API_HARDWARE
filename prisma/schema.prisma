generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================= ENUMS =================
enum MovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  RETURN
  DAMAGE
}

enum TaxCategory {
  STANDARD_VAT
  ZERO_VAT
  EXEMPT
}

enum SaleType {
  CASH
  CREDIT
  CARD
  MIXED
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum InvoiceStatus {
  COMPLETED
  PENDING
  CANCELLED
  RETURNED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ReturnCondition {
  GOOD
  DAMAGED
  EXPIRED
}

enum RefundMethod {
  CASH
  CREDIT_NOTE
  EXCHANGE
  ACCOUNT_DEDUCTION
}

enum CreditNoteStatus {
  ISSUED
  REDEEMED
  EXPIRED
}

enum ReportType {
  WEEKLY
  MONTHLY
}

// ================= CORE / TENANT MODELS =================
model TenantSetting {
  tenantId         String   @id @map("tenant_id") @db.Uuid
  maxCategoryDepth Int      @default(3) @map("max_category_depth")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("tenant_settings")
}

model User {
  user_id               String    @id @default(uuid()) @db.Uuid
  tenant_id             String    @db.Uuid 
  email                 String    @unique
  password_hash         String
  first_name            String?
  last_name             String?
  role                  String    @default("cashier")
  is_active             Boolean   @default(true)
  is_verified           Boolean   @default(false)
  two_factor_enabled    Boolean   @default(false)
  last_login            DateTime?
  failed_login_attempts Int       @default(0)
  account_locked_until  DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  shop              Shop                @relation(fields: [tenant_id], references: [id])
  managedBranches   Branch[]            @relation("BranchManager")
  managedWarehouses Warehouse[]         @relation("WarehouseManager")
  createdProducts   Product[]           @relation("ProductCreatedBy")
  stockMovements    StockMovement[]     @relation("MovementCreator")
  salesInvoices     SalesInvoice[]      @relation("InvoiceCashier")
  receivedGrns      GoodsReceivedNote[] @relation("GrnReceiver")
  createdReturns    SalesReturn[]       @relation("ReturnCreator")
  approvedReturns   SalesReturn[]       @relation("ReturnApprover")

  @@map("users")
}

model Shop {
  id                   String  @id @default(uuid()) @map("shop_id") @db.Uuid
  name                 String  @map("shop_name") @db.VarChar(200)
  businessRegistration String? @map("business_registration") @db.VarChar(100)
  email                String?

  users              User[]
  branches           Branch[]
  warehouses         Warehouse[]
  categories         Category[]
  brands             Brand[]
  units              Unit[]
  products           Product[]
  productVariants    ProductVariant[]
  stocks             Stock[]
  stockMovements     StockMovement[]
  salesInvoices      SalesInvoice[]
  goodsReceivedNotes GoodsReceivedNote[]
  customers          Customer[]
  salesReturns       SalesReturn[]
  creditNotes        CreditNote[]
  generatedReports   GeneratedReport[]
  suppliers          Supplier[]

  @@map("shops")
}

model AdvanceTaxPayment {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  paymentDate DateTime @map("payment_date") @db.Date
  amount      Float
  reference   String?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("advance_tax_payments")
}

model Branch {
  id       String  @id @default(uuid()) @map("branch_id") @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String  @map("branch_name") @db.VarChar(200)
  code     String? @unique @map("branch_code") @db.VarChar(50)

  managerId String?  @map("manager_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop          Shop           @relation(fields: [tenantId], references: [id])
  manager       User?          @relation("BranchManager", fields: [managerId], references: [user_id])
  warehouses    Warehouse[]
  stocks        Stock[]
  salesInvoices SalesInvoice[]
  salesReturns  SalesReturn[]

  @@map("branches")
}

// ================= CATALOG MODELS =================
model Category {
  id               String     @id @default(uuid()) @map("category_id") @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  categoryName     String     @map("category_name")
  categoryCode     String     @map("category_code")
  description      String?
  parentCategoryId String?    @map("parent_category_id") @db.Uuid
  categoryLevel    Int?       @map("category_level")
  displayOrder     Int?       @map("display_order")
  iconUrl          String?    @map("icon_url")
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  shop             Shop       @relation(fields: [tenantId], references: [id])
  parentCategory   Category?  @relation("CategoryToCategory", fields: [parentCategoryId], references: [id])
  subCategories    Category[] @relation("CategoryToCategory")
  products         Product[]

  @@unique([tenantId, categoryCode])
  @@index([tenantId])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid()) @map("brand_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  brandName   String   @map("brand_name")
  description String?
  logoUrl     String?  @map("logo_url")
  website     String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop        Shop     @relation(fields: [tenantId], references: [id])
  products    Product[]

  @@unique([tenantId, brandName])
  @@index([tenantId])
  @@map("brands")
}

model Unit {
  id          String   @id @default(uuid()) @map("unit_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  unitName    String   @map("unit_name")
  unitCode    String   @map("unit_code")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop        Shop     @relation(fields: [tenantId], references: [id])
  products    Product[]

  @@unique([tenantId, unitName])
  @@index([tenantId])
  @@map("units")
}

model Product {
  id                  String         @id @default(uuid()) @map("product_id") @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  name                String         @map("product_name")
  description         String?        @map("product_description")
  sku                 String         @map("sku")
  barcode             String?        @map("barcode")
  categoryId          String         @map("category_id") @db.Uuid
  brandId             String?        @map("brand_id") @db.Uuid
  unitId              String?        @map("unit_id") @db.Uuid
  purchasePrice       Decimal?       @db.Decimal(10, 2) @map("purchase_price")
  sellingPrice        Decimal        @db.Decimal(10, 2) @map("selling_price")
  minimumSellingPrice Decimal?       @db.Decimal(10, 2) @map("minimum_selling_price")
  markupPercentage    Decimal?       @db.Decimal(5, 2) @map("markup_percentage")
  taxRate             Decimal?       @db.Decimal(5, 2) @map("tax_rate")
  taxCategory         TaxCategory?   @map("tax_category") 
  minimumStockLevel   Decimal?       @db.Decimal(10, 2) @map("minimum_stock_level")
  maximumStockLevel   Decimal?       @db.Decimal(10, 2) @map("maximum_stock_level")
  reorderQuantity     Decimal?       @db.Decimal(10, 2) @map("reorder_quantity")
  warrantyMonths      Int?           @map("warranty_months")
  hasVariants         Boolean        @default(false) @map("has_variants")
  isActive            Boolean        @default(true) @map("is_active")
  createdBy           String?        @map("created_by") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  shop                Shop               @relation(fields: [tenantId], references: [id])
  category            Category           @relation(fields: [categoryId], references: [id])
  brand               Brand?             @relation(fields: [brandId], references: [id])
  unit                Unit?              @relation(fields: [unitId], references: [id])
  creator             User?              @relation("ProductCreatedBy", fields: [createdBy], references: [user_id])
  variants            ProductVariant[]
  images              ProductImage[]
  stocks              Stock[]
  stockMovements      StockMovement[]
  grnItems            GrnItem[]
  salesInvoiceItems   SalesInvoiceItem[]
  returnedItems       SalesReturnItem[]
  supplierProducts    SupplierProduct[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, categoryId])
  @@index([tenantId, name])
  @@map("products")
}

model ProductVariant {
  id                String   @id @default(uuid()) @map("variant_id") @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  variantName       String?  @map("variant_name")
  sku               String   @map("sku")
  barcode           String?  @map("barcode")
  variantAttributes Json?    @map("variant_attributes")
  purchasePrice     Decimal? @map("purchase_price") @db.Decimal(10, 2)
  sellingPrice      Decimal? @map("selling_price") @db.Decimal(10, 2)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product           Product            @relation(fields: [productId], references: [id])
  shop              Shop               @relation(fields: [tenantId], references: [id])
  stocks            Stock[]
  stockMovements    StockMovement[]
  grnItems          GrnItem[]
  salesInvoiceItems SalesInvoiceItem[]
  returnedItems     SalesReturnItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, productId])
  @@map("product_variants")
}

model ProductImage {
  id           String   @id @default(uuid()) @map("image_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  imageUrl     String   @map("image_url")
  thumbnailUrl String?  @map("thumbnail_url")
  displayOrder Int?     @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

// ================= INVENTORY MODELS =================
model Warehouse {
  id                 String              @id @default(uuid()) @map("warehouse_id") @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  branchId           String              @map("branch_id") @db.Uuid
  name               String              @map("warehouse_name") @db.VarChar(200)
  code               String?             @unique @map("warehouse_code") @db.VarChar(50)
  address            String?             @db.Text
  capacity           Decimal?            @db.Decimal(10, 2)
  managerId          String?             @map("manager_id") @db.Uuid
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  shop               Shop                @relation(fields: [tenantId], references: [id])
  branch             Branch              @relation(fields: [branchId], references: [id])
  manager            User?               @relation("WarehouseManager", fields: [managerId], references: [user_id])
  stocks             Stock[]
  stockMovements     StockMovement[]
  goodsReceivedNotes GoodsReceivedNote[]
  salesInvoiceItems  SalesInvoiceItem[]
  returnedItems      SalesReturnItem[]

  @@map("warehouses")
}

model Stock {
  id                String          @id @default(uuid()) @map("stock_id") @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  productId         String          @map("product_id") @db.Uuid
  variantId         String?         @map("variant_id") @db.Uuid
  warehouseId       String          @map("warehouse_id") @db.Uuid
  branchId          String          @map("branch_id") @db.Uuid
  
  quantity          Decimal         @db.Decimal(10, 2)
  reservedQuantity  Decimal         @default(0) @db.Decimal(10, 2) @map("reserved_quantity")
  availableQuantity Decimal?        @db.Decimal(10, 2) @map("available_quantity") 
  damagedQuantity   Decimal         @default(0) @db.Decimal(10, 2) @map("damaged_quantity")
  
  lastUpdated       DateTime        @updatedAt @map("last_updated")

  shop      Shop            @relation(fields: [tenantId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  branch    Branch          @relation(fields: [branchId], references: [id])

  @@unique([productId, variantId, warehouseId])
  @@map("stock")
}

model StockMovement {
  id             String          @id @default(uuid()) @map("movement_id") @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  variantId      String?         @map("variant_id") @db.Uuid
  warehouseId    String          @map("warehouse_id") @db.Uuid
  
  movementType   MovementType    @map("movement_type")
  quantity       Decimal         @db.Decimal(10, 2)
  beforeQuantity Decimal?        @db.Decimal(10, 2) @map("before_quantity")
  afterQuantity  Decimal?        @db.Decimal(10, 2) @map("after_quantity")
  
  unitCost       Decimal?        @db.Decimal(10, 2) @map("unit_cost")
  totalCost      Decimal?        @db.Decimal(10, 2) @map("total_cost")
  
  referenceType  String?         @db.VarChar(50) @map("reference_type")
  referenceId    String?         @db.Uuid @map("reference_id")
  notes          String?         @db.Text
  
  createdBy      String?         @map("created_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")

  shop           Shop            @relation(fields: [tenantId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  creator        User?           @relation("MovementCreator", fields: [createdBy], references: [user_id])

  @@map("stock_movements")
}

model GoodsReceivedNote {
  id              String      @id @default(uuid()) @map("grn_id") @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  warehouseId     String      @map("warehouse_id") @db.Uuid
  purchaseOrderId String?     @map("purchase_order_id") @db.Uuid 
  
  grnNumber       String      @unique @map("grn_number") @db.VarChar(50)
  receivedDate    DateTime    @default(now()) @map("received_date") @db.Date
  status          String      @default("completed") @db.VarChar(20)
  notes           String?     @db.Text
  
  receivedBy      String?     @map("received_by") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  shop            Shop        @relation(fields: [tenantId], references: [id])
  warehouse       Warehouse   @relation(fields: [warehouseId], references: [id])
  receiver        User?       @relation("GrnReceiver", fields: [receivedBy], references: [user_id])
  items           GrnItem[]

  @@map("goods_received_notes")
}

model GrnItem {
  id        String  @id @default(uuid()) @map("grn_item_id") @db.Uuid
  grnId     String  @map("grn_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid

  quantity  Decimal @db.Decimal(10, 2)
  unitCost  Decimal @map("unit_cost") @db.Decimal(10, 2)
  totalCost Decimal @map("total_cost") @db.Decimal(10, 2)

  grn     GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  product Product           @relation(fields: [productId], references: [id])
  variant ProductVariant?   @relation(fields: [variantId], references: [id])

  @@map("grn_items")
}

// ================= SALES & INVOICING =================
model SalesInvoice {
  id            String   @id @default(uuid()) @map("invoice_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  customerId    String?  @map("customer_id") @db.Uuid
  invoiceNumber String   @unique @map("invoice_number") @db.VarChar(50)
  invoiceDate   DateTime @map("invoice_date") @db.Date
  invoiceTime   DateTime @map("invoice_time") @db.Time

  saleType           SaleType @map("sale_type")
  subtotal           Decimal  @db.Decimal(10, 2)
  discountAmount     Decimal  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  discountPercentage Decimal? @map("discount_percentage") @db.Decimal(5, 2)
  taxAmount          Decimal? @map("tax_amount") @db.Decimal(10, 2)
  totalAmount        Decimal  @map("total_amount") @db.Decimal(10, 2)

  paidAmount   Decimal @default(0) @map("paid_amount") @db.Decimal(10, 2)
  changeAmount Decimal @default(0) @map("change_amount") @db.Decimal(10, 2)
  balance      Decimal @default(0) @db.Decimal(10, 2)

  paymentStatus PaymentStatus @map("payment_status")
  status        InvoiceStatus
  notes         String?       @db.Text

  cashierId String?  @map("cashier_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop     Shop      @relation(fields: [tenantId], references: [id])
  branch   Branch    @relation(fields: [branchId], references: [id])
  cashier  User?     @relation("InvoiceCashier", fields: [cashierId], references: [user_id])
  customer Customer? @relation(fields: [customerId], references: [id])

  items        SalesInvoiceItem[]
  salesReturns SalesReturn[]

  @@index([tenantId, createdAt])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id                 String   @id @default(uuid()) @map("item_id") @db.Uuid
  invoiceId          String   @map("invoice_id") @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  variantId          String?  @map("variant_id") @db.Uuid
  productName        String?  @map("product_name") @db.VarChar(200)
  quantity           Decimal  @db.Decimal(10, 2)
  unitPrice          Decimal  @map("unit_price") @db.Decimal(10, 2)
  discountAmount     Decimal? @default(0) @map("discount_amount") @db.Decimal(10, 2)
  discountPercentage Decimal? @map("discount_percentage") @db.Decimal(5, 2)
  taxRate            Decimal? @map("tax_rate") @db.Decimal(5, 2)
  taxAmount          Decimal? @map("tax_amount") @db.Decimal(10, 2)
  lineTotal          Decimal  @map("line_total") @db.Decimal(10, 2)
  costPrice          Decimal? @map("cost_price") @db.Decimal(10, 2)
  profit             Decimal? @map("profit") @db.Decimal(10, 2)
  warehouseId        String   @map("warehouse_id") @db.Uuid

  invoice       SalesInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id])
  variant       ProductVariant?   @relation(fields: [variantId], references: [id])
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  returnedItems SalesReturnItem[]

  @@map("sales_invoice_items")
}

// ================= CUSTOMERS, SALES RETURNS & CREDIT NOTES =================
model Customer {
  id                 String   @id @default(uuid()) @map("customer_id") @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  name               String   @map("customer_name") @db.VarChar(200)
  phone              String   @db.VarChar(20)
  outstandingBalance Decimal  @default(0) @map("outstanding_balance") @db.Decimal(10, 2)
  totalPurchases     Decimal  @default(0) @map("total_purchases") @db.Decimal(10, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  shop          Shop           @relation(fields: [tenantId], references: [id])
  salesReturns  SalesReturn[]
  creditNotes   CreditNote[]
  salesInvoices SalesInvoice[]

  @@map("customers")
}

model SalesReturn {
  id         String  @id @default(uuid()) @map("return_id") @db.Uuid
  retNumber  String  @unique @map("ret_number") @db.VarChar(50)
  tenantId   String  @map("tenant_id") @db.Uuid
  branchId   String  @map("branch_id") @db.Uuid
  invoiceId  String  @map("invoice_id") @db.Uuid
  customerId String? @map("customer_id") @db.Uuid

  status       ReturnStatus @default(PENDING)
  totalAmount  Decimal      @map("total_amount") @db.Decimal(10, 2)
  refundMethod RefundMethod @map("refund_method")
  reason       String?      @db.Text

  createdBy  String?  @map("created_by")   @db.Uuid
  approvedBy String?  @map("approved_by")  @db.Uuid 
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  shop     Shop         @relation(fields: [tenantId], references: [id])
  branch   Branch       @relation(fields: [branchId], references: [id])
  invoice  SalesInvoice @relation(fields: [invoiceId], references: [id])
  customer Customer?    @relation(fields: [customerId], references: [id])
  creator  User?        @relation("ReturnCreator", fields: [createdBy], references: [user_id])
  approver User?        @relation("ReturnApprover", fields: [approvedBy], references: [user_id])

  items       SalesReturnItem[]
  creditNotes CreditNote[]

  @@map("sales_returns")
}

model SalesReturnItem {
  id            String  @id @default(uuid()) @map("return_item_id") @db.Uuid
  salesReturnId String  @map("sales_return_id") @db.Uuid
  invoiceItemId String  @map("invoice_item_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  variantId     String? @map("variant_id") @db.Uuid
  warehouseId   String  @map("warehouse_id") @db.Uuid

  quantity  Decimal         @db.Decimal(10, 2)
  condition ReturnCondition
  unitPrice Decimal         @map("unit_price") @db.Decimal(10, 2)
  lineTotal Decimal         @map("line_total") @db.Decimal(10, 2)

  salesReturn SalesReturn      @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  invoiceItem SalesInvoiceItem @relation(fields: [invoiceItemId], references: [id])
  product     Product          @relation(fields: [productId], references: [id])
  variant     ProductVariant?  @relation(fields: [variantId], references: [id])
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])

  @@map("sales_return_items")
}

model CreditNote {
  id               String @id @default(uuid()) @map("credit_note_id") @db.Uuid
  creditNoteNumber String @unique @map("credit_note_number") @db.VarChar(50)
  tenantId         String @map("tenant_id") @db.Uuid
  salesReturnId    String @map("sales_return_id") @db.Uuid
  customerId       String @map("customer_id") @db.Uuid

  amount     Decimal          @db.Decimal(10, 2)
  expiryDate DateTime         @map("expiry_date") @db.Date
  status     CreditNoteStatus @default(ISSUED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop        Shop        @relation(fields: [tenantId], references: [id])
  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id])
  customer    Customer    @relation(fields: [customerId], references: [id])

  @@map("credit_notes")
}

// ================= ANALYTICS & REPORTS =================
model GeneratedReport {
  id         String     @id @default(uuid()) @map("report_id") @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  reportType ReportType @map("report_type")
  startDate  DateTime   @map("start_date") @db.Date
  endDate    DateTime   @map("end_date") @db.Date
  data       Json // Stores the generated JSON analytics payload
  createdAt  DateTime   @default(now()) @map("created_at")
  expiresAt  DateTime   @map("expires_at") // TTL for cache invalidation

  shop Shop @relation(fields: [tenantId], references: [id])

  @@index([tenantId, reportType, startDate])
  @@map("generated_reports")
}

// ================= SUPPLIERS & PURCHASING =================
model Supplier {
  id            String   @id @default(uuid()) @map("supplier_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String   @map("supplier_name") @db.VarChar(200)
  supplierCode  String?  @unique @map("supplier_code") @db.VarChar(50)
  contactPerson String?  @map("contact_person") @db.VarChar(100)
  email         String?  @db.VarChar(100)
  phone         String?  @db.VarChar(20)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  shop             Shop              @relation(fields: [tenantId], references: [id])
  supplierProducts SupplierProduct[]

  @@map("suppliers")
}

model SupplierProduct {
  id            String   @id @default(uuid()) @map("supplier_product_id") @db.Uuid
  supplierId    String   @map("supplier_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  supplierPrice Decimal? @map("supplier_price") @db.Decimal(10, 2)
  isPreferred   Boolean  @default(false) @map("is_preferred")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@map("supplier_products")
}
